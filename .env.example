PUBLIC_SUPABASE_URL=https://XXXXX.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# B-02 Phase 2: soft-reserve TTL minutes. Default 20 if unset.
SOFT_RESERVE_TTL_MINUTES=20
# Shared secret for Netlify scheduled functions calling internal endpoints
# (sweep-pending alongside the existing sync-bc).
SWEEP_SECRET=your-secret-here
# PR 4: HMAC secret for guest cancellation magic-link tokens. 32+ random bytes
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
CANCEL_TOKEN_SECRET=your-secret-here
BOOKING_COM_ICAL_URL=https://...
PUBLIC_SITE_URL=https://mariannecottage.netlify.app
PUBLIC_DEFAULT_LOCALE=en
PUBLIC_GOOGLE_MAPS_API_KEY=
SYNC_SECRET=your-secret-here
ANTHROPIC_API_KEY=sk-ant-...
# PR 5: Resend transactional email. Leave RESEND_API_KEY unset to fall back to
# the stub service (logs to stdout). Both RESEND_API_KEY and EMAIL_FROM must be
# set for real sends; otherwise the stub is used.
RESEND_API_KEY=re_...
EMAIL_FROM=Marianne Cottage <bookings@mariannecottage.fr>
EMAIL_REPLY_TO=bookings@mariannecottage.fr
# Comma-separated list of admin recipients for contact-enquiry notifications.
ADMIN_NOTIFY_EMAIL=mark@example.com
# Set EMAIL_DRY_RUN=true on preview/branch deploys to log instead of send.
EMAIL_DRY_RUN=
