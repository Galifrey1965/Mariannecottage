PUBLIC_SUPABASE_URL=https://XXXXX.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# B-02 Phase 2: soft-reserve TTL minutes. Default 20 if unset.
SOFT_RESERVE_TTL_MINUTES=20
# Shared secret for Netlify scheduled functions calling internal endpoints
# (sweep-pending alongside the existing sync-bc).
SWEEP_SECRET=your-secret-here
# PR 4: HMAC secret for guest cancellation magic-link tokens. 32+ random bytes
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
CANCEL_TOKEN_SECRET=your-secret-here
BOOKING_COM_ICAL_URL=https://...
PUBLIC_SITE_URL=https://mariannecottage.netlify.app
PUBLIC_DEFAULT_LOCALE=en
PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-side key for build-time fetches against the Places (New) API.
# Used by scripts/fetch-google-rating.mjs.
GOOGLE_PLACES_API_KEY=
# Server-side key for build-time fetches against the Static Maps API.
# Used by scripts/fetch-static-map.mjs to pre-render the cottage location
# PNG behind the GDPR consent overlay on /contact. Same key in Netlify
# build env (server-only — never exposed to the client).
GOOGLE_STATIC_MAPS=
SYNC_SECRET=your-secret-here
ANTHROPIC_API_KEY=sk-ant-...
# PR 5: Brevo transactional email (v3 HTTP API).
# Brevo account/DNS already provisioned per documentation/infrastructure.md.
# Generate the API key in Brevo dashboard → SMTP & API → API Keys (separate
# from the SMTP key used for Gmail "Send mail as"). Leave BREVO_API_KEY unset
# to fall back to the stub (logs to stdout).
BREVO_API_KEY=xkeysib-...
EMAIL_FROM=Marianne Cottage <booking@mariannecottage.fr>
EMAIL_REPLY_TO=booking@mariannecottage.fr
# Comma-separated list of admin recipients for contact-enquiry notifications.
# In production: Mark's chosen inbox + admin@mariannecottage.fr (set in Netlify,
# kept out of this committed example).
ADMIN_NOTIFY_EMAIL=admin@mariannecottage.fr
# Set EMAIL_DRY_RUN=true on preview/branch deploys to log instead of send.
EMAIL_DRY_RUN=
